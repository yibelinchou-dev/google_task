        "OAuth token refresh",
        "Batch import with retries",
        "Emit per-list progress"
      ]
    },
    {
      "component": "iOS Offline Store",
      "description": "On-device SQLite/SwiftData cache so list switching stays fast offline and syncs when network returns.",
      "technologies": [
        "SwiftData",
