      ],
      "responsibilities": [
        "Local CRUD",
        "Queue outbound mutations",
        "Render sidebar and search"
      ]
    }
  ],
  "api_contracts": [
    {
      "endpoint": "/v1/lists",
      "method": "GET",
      "description": "Return all lists for the authenticated user ordered by pin then name.",
      "request_schema": {
        "query": {
          "cursor": "string?"
        }
      },
      "response_schema": {
        "lists": [
          {
            "id": "uuid",
            "name": "string",
            "pinned": "bool",
            "task_count": "int"
          }
        ]
      },
      "authentication": "Bearer JWT",
      "rate_limits": "120/min per user"
    },
    {
      "endpoint": "/v1/lists/{list_id}/tasks",
      "method": "GET",
      "description": "Page tasks in a list including incomplete by default; archive filter optional.",
      "request_schema": {
        "query": {
          "status": "active|archived|all",
          "q": "string?"
        }
      },
      "response_schema": {
        "tasks": [
          {
            "id": "uuid",
            "title": "string",
            "notes": "string?",
            "archived_at": "datetime?"
          }
        ]
      },
      "authentication": "Bearer JWT",
      "rate_limits": "120/min per user"
    },
    {
      "endpoint": "/v1/import/google-tasks",
      "method": "POST",
      "description": "Start a Google Tasks import job using stored OAuth credentials or uploaded export.",
      "request_schema": {
        "body": {
          "source": "oauth|export",
          "export_file_id": "string?"
        }
      },
      "response_schema": {
        "job_id": "uuid",
        "status": "queued"
      },
      "authentication": "Bearer JWT + Pro entitlement",
      "rate_limits": "5 starts/hour"
    },
    {
      "endpoint": "/v1/import/jobs/{job_id}",
      "method": "GET",
      "description": "Poll import job progress including per-list counts and failures.",
      "request_schema": {},
      "response_schema": {
        "status": "queued|running|done|failed",
        "lists_done": "int",
        "errors": [
          "string"
        ]
      },
      "authentication": "Bearer JWT",
      "rate_limits": "60/min"
    },
    {
      "endpoint": "/v1/waitlist",
      "method": "POST",
      "description": "Capture waitlist email and approximate Google Tasks list count for validation interviews.",
      "request_schema": {
        "body": {
          "email": "string",
          "list_count_estimate": "int?"
        }
      },
      "response_schema": {
        "ok": "bool"
      },
      "authentication": "none (rate-limited)",
      "rate_limits": "10/hour/IP"
    }
  ],
